# Mini D-Mart Environment Variables Example

# ===================================================================
# Backend Configuration (.env or system environment)
# ===================================================================
# For Production PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/minidmart
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://mini-dmart.vercel.app

# ===================================================================
# Frontend Configuration (.env)
# ===================================================================
VITE_API_BASE_URL=http://localhost:8080/api
